---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const pages = await getCollection('pages');
---
<BaseLayout
  title="Boa Esperança — Cultura, Comunidade e Memórias"
  description="Casa cultural e comunidade lusófona: crónicas, encontros, tradições e arquivo comunitário."
>
  <section class="card" style="margin-bottom: 28px; border-top: 4px solid var(--azulejo);">
    <p style="font-family: -apple-system, sans-serif; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--terracotta); margin: 0 0 8px;">
      Bem-vindos à Casa da Boa Esperança
    </p>
    <h1 style="margin: 0 0 12px; font-size: 2rem; color: var(--azulejo); line-height: 1.25;">
      Cultura, Comunidade e Memórias Partilhadas
    </h1>
    <p style="margin: 0 0 14px;">
      Espaço comunitário dedicado à língua portuguesa, à partilha de histórias familiares, encontros culturais e preservação do nosso arquivo digital.
    </p>
    <p style="margin: 0; font-size: 0.95rem; color: var(--muted);">
      A Lusophone cultural and community home preserving local chronicles, gathering notes, and bilingual heritage in a fast, open static archive.
    </p>
  </section>

  <section style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 32px;">
    <div class="card" style="padding: 20px;">
      <h2 style="margin: 0 0 8px; font-size: 1.1rem; color: var(--azulejo);">Memória &amp; Património</h2>
      <p style="margin: 0; font-size: 0.92rem; color: var(--muted);">Histórias comunitárias, receitas tradicionais, música e registos preservados sem dependências pesadas.</p>
    </div>
    <div class="card" style="padding: 20px;">
      <h2 style="margin: 0 0 8px; font-size: 1.1rem; color: var(--azulejo);">Encontros &amp; Diálogo</h2>
      <p style="margin: 0; font-size: 0.92rem; color: var(--muted);">Ponto de encontro entre gerações da diáspora e amigos da cultura portuguesa.</p>
    </div>
    <div class="card" style="padding: 20px;">
      <h2 style="margin: 0 0 8px; font-size: 1.1rem; color: var(--azulejo);">Edição Aberta</h2>
      <p style="margin: 0; font-size: 0.92rem; color: var(--muted);">Publicação estática em Astro com gestão editorial via <a href="/admin/">Sveltia CMS</a> e subscrição <a href="/rss.xml">RSS</a>.</p>
    </div>
  </section>

  <section class="card" style="margin-bottom: 24px;">
    <h2 style="margin: 0 0 16px; font-size: 1.35rem; color: var(--azulejo);">Crónicas &amp; Publicações Recentes</h2>
    {posts.map((post) => (
      <article style="padding: 16px 0; border-top: 1px solid var(--border);">
        <div style="font-family: -apple-system, sans-serif; font-size: 0.82rem; color: var(--muted);">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          &middot; {post.data.category}
        </div>
        <h3 style="margin: 4px 0 6px; font-size: 1.2rem;">
          <a href={`/${post.id}/`} style="text-decoration: none;">{post.data.title}</a>
        </h3>
        <p style="margin: 0; color: var(--muted);">{post.data.description}</p>
      </article>
    ))}
  </section>

  <section class="card">
    <h2 style="margin: 0 0 12px; font-size: 1.2rem; color: var(--azulejo);">Páginas do Arquivo</h2>
    <ul style="margin: 0; padding-left: 20px;">
      {pages.map((page) => (
        <li>
          <a href={`/${page.id}/`}>{page.data.title}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
