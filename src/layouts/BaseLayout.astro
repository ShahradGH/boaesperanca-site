---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Boa Esperança — Cultura, Comunidade e Memórias Lusófonas' } = Astro.props;
---
<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Boa Esperança RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/uploads/boa-esperanca-crest.svg" />
    <style>
      :root {
        --bg: #faf7f2;
        --surface: #ffffff;
        --ink: #1e293b;
        --muted: #526071;
        --azulejo: #103b66;
        --azulejo-soft: #e6eef7;
        --terracotta: #b45309;
        --border: #e5ddd0;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: Georgia, "Times New Roman", serif;
        line-height: 1.7;
      }
      header {
        background: var(--azulejo);
        color: #ffffff;
        border-bottom: 4px solid var(--terracotta);
      }
      .wrap {
        max-width: 880px;
        margin: 0 auto;
        padding: 0 20px;
      }
      .nav-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 20px 0;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #ffffff;
      }
      .brand-title {
        font-size: 1.45rem;
        font-weight: 700;
        letter-spacing: 0.01em;
      }
      .brand-sub {
        display: block;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 0.78rem;
        color: #cbd5e1;
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 0.9rem;
      }
      nav a {
        color: #f8fafc;
        text-decoration: none;
        padding: 4px 8px;
        border-radius: 6px;
      }
      nav a:hover {
        background: rgba(255, 255, 255, 0.14);
      }
      main {
        padding: 36px 0 64px;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 28px;
        box-shadow: 0 8px 24px rgba(16, 59, 102, 0.05);
      }
      footer {
        border-top: 1px solid var(--border);
        padding: 24px 0 40px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 0.85rem;
        color: var(--muted);
      }
      a { color: var(--azulejo); }
      blockquote {
        margin: 20px 0;
        padding: 12px 20px;
        border-left: 4px solid var(--terracotta);
        background: #fdf9f3;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap nav-bar">
        <a class="brand" href="/">
          <img src="/uploads/boa-esperanca-crest.svg" alt="Emblema Boa Esperança" width="38" height="38" />
          <div>
            <span class="brand-title">Boa Esperança</span>
            <span class="brand-sub">Cultura, Comunidade &amp; Arquivo Editorial</span>
          </div>
        </a>
        <nav aria-label="Navegação principal">
          <a href="/">Início</a>
          <a href="/hello-world/">Crónicas</a>
          <a href="/sample-page/">Sobre</a>
          <a href="/rss.xml">RSS</a>
          <a href="/admin/">CMS</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        Boa Esperança &middot; Arquivo cultural e comunitário &middot; <a href="/rss.xml">Subscrever RSS</a> &middot; <a href="/admin/">Gerir Conteúdo (Sveltia CMS)</a>
      </div>
    </footer>
  </body>
</html>
